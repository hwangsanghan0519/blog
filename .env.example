# Public build-time configuration (GA4 web stream measurement ID).
VITE_GA_MEASUREMENT_ID=
# Enable only for a separate test property / DebugView. Never enable for production.
VITE_GA_DEBUG=false

# Server-only Netlify Function environment variables. Never prefix these with VITE_.
GA_PROPERTY_ID=
# Paste the complete service-account JSON as the Netlify environment variable value.
GA_SERVICE_ACCOUNT_JSON=

# Celeb Story: server-only Facebook Login / Instagram Business Discovery.
# Never prefix the token with VITE_ or include it in client code.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_GRAPH_VERSION=v26.0
# Optional complete roster, matched to the site's category names. Max 30 accounts.
# INSTAGRAM_CELEB_ACCOUNTS=[{"name":"수영","username":"sooyoungchoi"},{"name":"한소희","username":"xeesoxee"}]
